        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo trasladar “%@” a la papelera: %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de placer « %@ » dans la corbeille : %@"

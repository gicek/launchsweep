    "Every app registered with macOS is still on disk and in a usual place." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle bei macOS registrierten Apps sind noch vorhanden und liegen an einem üblichen Ort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las apps registradas en macOS siguen en el disco y en una ubicación habitual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les apps enregistrées auprès de macOS sont toujours sur le disque et à un emplacement habituel."

    "Copies in temporary folders, such as apps that macOS ran from a randomized location." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopien in temporären Ordnern, etwa Apps, die macOS von einem zufälligen Ort aus gestartet hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copias en carpetas temporales, como las apps que macOS ejecutó desde una ubicación aleatoria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copies situées dans des dossiers temporaires, comme les apps que macOS a exécutées depuis un emplacement aléatoire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一時フォルダ内のコピーです。macOS がランダムな場所から実行したアプリなどが該当します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "임시 폴더에 있는 사본입니다. macOS가 임의의 위치에서 실행한 앱 등이 해당합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于临时文件夹中的副本，例如 macOS 从随机位置运行的应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於暫存檔案夾中的副本，例如 macOS 從隨機位置執行的 App。"
          }
        }
      }
    },
    "Copies outside the usual app folders that share a bundle identifier with another registered app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopien außerhalb der üblichen App-Ordner, die dieselbe Bundle-ID wie eine andere registrierte App haben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copias fuera de las carpetas habituales de apps que comparten el identificador de paquete con otra app registrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copies situées hors des dossiers d’apps habituels et partageant leur identifiant de bundle avec une autre app enregistrée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常のアプリフォルダの外にあり、登録済みの別のアプリとバンドル ID が同じコピーです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일반적인 앱 폴더 밖에 있으며 등록된 다른 앱과 번들 ID가 같은 사본입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于常规应用文件夹之外、且与另一个已登记应用使用相同 Bundle ID 的副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於一般 App 檔案夾之外、且與另一個已註冊 App 使用相同 Bundle ID 的副本。"
          }
        }
      }
    },
    "Copies produced by builds. macOS registers them again the next time it sees them, for example after another build." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Build erzeugte Kopien. macOS registriert sie erneut, sobald es sie wieder findet, etwa nach dem nächsten Build."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copias generadas al compilar. macOS las vuelve a registrar la próxima vez que las detecta, por ejemplo tras otra compilación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copies produites par des compilations. macOS les enregistre de nouveau dès qu’il les revoit, par exemple après une nouvelle compilation."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビルドで生成されたコピーです。次のビルド後など、macOS が次に検出したときに再び登録されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빌드로 생성된 사본입니다. 다시 빌드한 후처럼 macOS가 다음에 발견하면 다시 등록합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "构建生成的副本。macOS 下次发现它们时会再次登记，例如再次构建之后。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建置產生的副本。macOS 下次發現它們時會再次註冊，例如再次建置之後。"
          }
        }
      }
    },

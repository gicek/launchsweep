// Copy to LaunchSweep.local.xcconfig (not committed). Use Automatic with an Apple Development certificate;
// with only a Developer ID certificate, which releases need (see Scripts/release.sh), use Manual:
//   CODE_SIGN_STYLE = Manual
//   CODE_SIGN_IDENTITY = Developer ID Application
//   PROVISIONING_PROFILE_SPECIFIER =
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM = YOURTEAMID
CODE_SIGN_IDENTITY = Apple Development

// Secure timestamp for Release builds, required for notarization (needs a real certificate, not ad-hoc).
OTHER_CODE_SIGN_FLAGS[config=Release] = --timestamp

// notarytool keychain profile used by Scripts/release.sh (default "LaunchSweep"; the environment variable
// NOTARY_PROFILE overrides it). Create it with:
//   xcrun notarytool store-credentials <profile> --apple-id <apple-id> --team-id <team-id>
// NOTARY_PROFILE = LaunchSweep
